  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="1480" posY="680">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_6" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="Object nextLinkObject =&#xD;&#xA;globalMap.get(&quot;row_next_link.NEXT_LINK&quot;);&#xD;&#xA;&#xD;&#xA;String nextLink =&#xD;&#xA;nextLinkObject == null&#xD;&#xA;    ? null&#xD;&#xA;    : String.valueOf(nextLinkObject).trim();&#xD;&#xA;&#xD;&#xA;boolean hasNextPage =&#xD;&#xA;nextLink != null&#xD;&#xA;&amp;&amp; !nextLink.isEmpty()&#xD;&#xA;&amp;&amp; !&quot;null&quot;.equalsIgnoreCase(nextLink);&#xD;&#xA;&#xD;&#xA;//Gestion défensive d'un éventuel nextLink relatif&#xD;&#xA;if (hasNextPage &amp;&amp; !nextLink.toLowerCase().startsWith(&quot;http&quot;)) {&#xD;&#xA;String currentUrl =&#xD;&#xA;    String.valueOf(globalMap.get(&quot;BC_CURRENT_URL&quot;));&#xD;&#xA;&#xD;&#xA;nextLink = java.net.URI&#xD;&#xA;    .create(currentUrl)&#xD;&#xA;    .resolve(nextLink)&#xD;&#xA;    .toString();&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Integer currentPage =&#xD;&#xA;(Integer) globalMap.get(&quot;BC_PAGE_NUMBER&quot;);&#xD;&#xA;&#xD;&#xA;if (currentPage == null) {&#xD;&#xA;currentPage = 1;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;if (hasNextPage) {&#xD;&#xA;&#xD;&#xA;globalMap.put(&quot;BC_NEXT_LINK&quot;, nextLink);&#xD;&#xA;globalMap.put(&quot;BC_CURRENT_URL&quot;, nextLink);&#xD;&#xA;globalMap.put(&quot;BC_HAS_NEXT_PAGE&quot;, Boolean.TRUE);&#xD;&#xA;globalMap.put(&quot;BC_PAGE_NUMBER&quot;, currentPage + 1);&#xD;&#xA;&#xD;&#xA;System.out.println(&#xD;&#xA;    &quot;FIN PAGE &quot; + currentPage&#xD;&#xA;    + &quot; — page suivante détectée.&quot;&#xD;&#xA;);&#xD;&#xA;&#xD;&#xA;} else {&#xD;&#xA;&#xD;&#xA;globalMap.put(&quot;BC_NEXT_LINK&quot;, null);&#xD;&#xA;globalMap.put(&quot;BC_HAS_NEXT_PAGE&quot;, Boolean.FALSE);&#xD;&#xA;&#xD;&#xA;System.out.println(&#xD;&#xA;    &quot;FIN PAGE &quot; + currentPage&#xD;&#xA;    + &quot; — dernière page atteinte.&quot;&#xD;&#xA;);&#xD;&#xA;}"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="LABEL" value="tJava_UPDATE_PAGINATION"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJava_6"/>
  </node>
