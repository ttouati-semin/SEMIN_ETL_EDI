    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="String currentUrl =&#xD;&#xA;String.valueOf(globalMap.get(&quot;BC_CURRENT_URL&quot;));&#xD;&#xA;&#xD;&#xA;if (&#xD;&#xA;currentUrl == null&#xD;&#xA;|| currentUrl.trim().isEmpty()&#xD;&#xA;|| &quot;null&quot;.equalsIgnoreCase(currentUrl)&#xD;&#xA;) {&#xD;&#xA;throw new RuntimeException(&#xD;&#xA;    &quot;BC_CURRENT_URL est vide : impossible d'appeler Business Central.&quot;&#xD;&#xA;);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;Integer pageNumber =&#xD;&#xA;(Integer) globalMap.get(&quot;BC_PAGE_NUMBER&quot;);&#xD;&#xA;&#xD;&#xA;if (pageNumber == null) {&#xD;&#xA;pageNumber = 1;&#xD;&#xA;globalMap.put(&quot;BC_PAGE_NUMBER&quot;, pageNumber);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;System.out.println();&#xD;&#xA;System.out.println(&#xD;&#xA;&quot;============================================================&quot;&#xD;&#xA;);&#xD;&#xA;System.out.println(&#xD;&#xA;&quot;DÉBUT PAGE &quot; + pageNumber + &quot; — maximum 1000 lignes&quot;&#xD;&#xA;);&#xD;&#xA;System.out.println(&#xD;&#xA;&quot;Objet API : &quot; + globalMap.get(&quot;BC_API_OBJECT&quot;)&#xD;&#xA;);&#xD;&#xA;System.out.println(&#xD;&#xA;&quot;URL       : &quot; + currentUrl&#xD;&#xA;);&#xD;&#xA;System.out.println(&#xD;&#xA;&quot;============================================================&quot;&#xD;&#xA;);"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;"/>
