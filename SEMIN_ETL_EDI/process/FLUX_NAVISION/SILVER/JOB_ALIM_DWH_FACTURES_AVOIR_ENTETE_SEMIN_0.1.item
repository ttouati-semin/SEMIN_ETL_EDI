    <elementParameter field="PASSWORD" name="configuration.dataSet.dataStore.snowflakeAuth.oauthPassword" value="enc:system.encryption.key.v1:sHqPy3225RqaMvkaLFXY1G0lWSwL25L8w1yAhN1/" show="false"/>
