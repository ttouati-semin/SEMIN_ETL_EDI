    <elementParameter field="PASSWORD" name="configuration.dataSet.dataStore.snowflakeAuth.clientSecret" value="enc:system.encryption.key.v1:I9GHarcTR0PO3wBRG1K5h07YKQ41f5vzJA4E+3CZ" show="false"/>
