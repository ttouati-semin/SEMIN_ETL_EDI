    <elementParameter field="CHECK" name="configuration.dataSet.dataStore.shareConnection" value="false" show="false"/>
    <elementParameter field="TACOKIT_VALUE_SELECTION" name="configuration.dataSet.tableName" value="&quot;&quot;"/>
    <elementParameter field="MEMO_SQL" name="configuration.sqlQuery" value="&quot;MERGE INTO &quot;&#xD;&#xA;+ context.Snowflake_BDD_Silver + &quot;.&quot;&#xD;&#xA;+ context.Snowflake_Schema_Silver&#xD;&#xA;+ &quot;.FACTURES_AVOIR_LIGNE_SEMIN AS TGT &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;USING ( &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;    WITH VE_AGG AS ( &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;        SELECT &quot;&#xD;&#xA;+ &quot;            VE.\&quot;Document No_\&quot; AS DOCUMENT_NO_, &quot;&#xD;&#xA;+ &quot;            VE.\&quot;Document Line No_\&quot; AS LINE_NO_, &quot;&#xD;&#xA;+ &quot;            VE.\&quot;Document Type\&quot; AS TYPE, &quot;&#xD;&#xA;&#xD;&#xA;/*&#xD;&#xA; * Colonnes descriptives :&#xD;&#xA; * on prend la valeur portée par la Value Entry ayant&#xD;&#xA; * le plus grand Entry No_ pour la ligne concernée.&#xD;&#xA; */&#xD;&#xA;+ &quot;            MAX_BY( &quot;&#xD;&#xA;+ &quot;                VE.\&quot;Item No_\&quot;, &quot;&#xD;&#xA;+ &quot;                VE.\&quot;Entry No_\&quot; &quot;&#xD;&#xA;+ &quot;            ) AS NO_, &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;            MAX_BY( &quot;&#xD;&#xA;+ &quot;                VE.\&quot;Location Code\&quot;, &quot;&#xD;&#xA;+ &quot;                VE.\&quot;Entry No_\&quot; &quot;&#xD;&#xA;+ &quot;            ) AS LOCATION_CODE, &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;            MAX_BY( &quot;&#xD;&#xA;+ &quot;                VE.\&quot;Salespers__Purch_ Code\&quot;, &quot;&#xD;&#xA;+ &quot;                VE.\&quot;Entry No_\&quot; &quot;&#xD;&#xA;+ &quot;            ) AS CODE_VENDEUR, &quot;&#xD;&#xA;&#xD;&#xA;/*&#xD;&#xA; * Colonnes additives issues de Value Entry :&#xD;&#xA; * plusieurs écritures peuvent correspondre à une même&#xD;&#xA; * ligne de facture.&#xD;&#xA; */&#xD;&#xA;+ &quot;            SUM( &quot;&#xD;&#xA;+ &quot;                VE.\&quot;Sales Amount (Actual)\&quot; &quot;&#xD;&#xA;+ &quot;            ) AS AMOUNT, &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;            SUM( &quot;&#xD;&#xA;+ &quot;                VE.\&quot;Sales Amount (Actual)\&quot; &quot;&#xD;&#xA;+ &quot;            ) AS VAT_BASE_AMOUNT, &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;            SUM( &quot;&#xD;&#xA;+ &quot;                VE.\&quot;Sales Amount (Actual)\&quot; &quot;&#xD;&#xA;+ &quot;            ) AS LINE_AMOUNT, &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;            SUM( &quot;&#xD;&#xA;+ &quot;                VE.\&quot;Coût semin (dev soc)\&quot; &quot;&#xD;&#xA;+ &quot;            ) AS COUT_SEMIN__DEV_SOC, &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;            SUM( &quot;&#xD;&#xA;+ &quot;                VE.\&quot;Cout transport (dev soc)\&quot; * -1 &quot;&#xD;&#xA;+ &quot;            ) AS COUT_TRANSPORT__DEV_SOC, &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;            SUM( &quot;&#xD;&#xA;+ &quot;                VE.\&quot;Invoiced Quantity\&quot; * -1 &quot;&#xD;&#xA;+ &quot;            ) AS QUANTITY_BASE &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;        FROM &quot;&#xD;&#xA;+ context.Snowflake_BDD + &quot;.&quot;&#xD;&#xA;+ context.Snowflake_Schema_SEMIN_SAS&#xD;&#xA;+ &quot;.\&quot;Value_Entry\&quot; VE &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;        WHERE VE.\&quot;Item Charge No_\&quot; = '' &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;          AND VE.\&quot;Item No_\&quot; NOT IN ( &quot;&#xD;&#xA;+ &quot;              'A01400', &quot;&#xD;&#xA;+ &quot;              'A11067', &quot;&#xD;&#xA;+ &quot;              'A11068', &quot;&#xD;&#xA;+ &quot;              'A11069', &quot;&#xD;&#xA;+ &quot;              'A11070', &quot;&#xD;&#xA;+ &quot;              'A11599', &quot;&#xD;&#xA;+ &quot;              'A12254' &quot;&#xD;&#xA;+ &quot;          ) &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;          AND VE.\&quot;Document Type\&quot; = '2' &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;        GROUP BY &quot;&#xD;&#xA;+ &quot;            VE.\&quot;Document No_\&quot;, &quot;&#xD;&#xA;+ &quot;            VE.\&quot;Document Line No_\&quot;, &quot;&#xD;&#xA;+ &quot;            VE.\&quot;Document Type\&quot; &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;    ) &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;    SELECT &quot;&#xD;&#xA;+ &quot;        VE.DOCUMENT_NO_ AS DOCUMENT_NO_, &quot;&#xD;&#xA;+ &quot;        VE.LINE_NO_ AS LINE_NO_, &quot;&#xD;&#xA;+ &quot;        VE.NO_ AS NO_, &quot;&#xD;&#xA;+ &quot;        VE.LOCATION_CODE AS LOCATION_CODE, &quot;&#xD;&#xA;+ &quot;        I.\&quot;Description\&quot; AS DESCRIPTION, &quot;&#xD;&#xA;+ &quot;        FL.UNIT_OF_MEASURE AS UNIT_OF_MEASURE, &quot;&#xD;&#xA;+ &quot;        FL.QUANTITY AS QUANTITY, &quot;&#xD;&#xA;+ &quot;        0 AS UNIT_COST__LCY, &quot;&#xD;&#xA;+ &quot;        VE.AMOUNT AS AMOUNT, &quot;&#xD;&#xA;+ &quot;        VE.VAT_BASE_AMOUNT AS VAT_BASE_AMOUNT, &quot;&#xD;&#xA;+ &quot;        VE.LINE_AMOUNT AS LINE_AMOUNT, &quot;&#xD;&#xA;+ &quot;        FL.POIDS_NET_ART__ACHETE AS POIDS_NET_ART__ACHETE, &quot;&#xD;&#xA;+ &quot;        FL.POIDS_NET_ART__FABRIQUE AS POIDS_NET_ART__FABRIQUE, &quot;&#xD;&#xA;+ &quot;        VE.CODE_VENDEUR AS CODE_VENDEUR, &quot;&#xD;&#xA;+ &quot;        VE.COUT_SEMIN__DEV_SOC AS COUT_SEMIN__DEV_SOC, &quot;&#xD;&#xA;+ &quot;        VE.COUT_TRANSPORT__DEV_SOC AS COUT_TRANSPORT__DEV_SOC, &quot;&#xD;&#xA;+ &quot;        FL.POIDS_NET_ART__PROFILES AS POIDS_NET_ART__PROFILES, &quot;&#xD;&#xA;+ &quot;        I.\&quot;Sales Unit of Measure\&quot; AS UNIT_OF_MEASURE_CODE, &quot;&#xD;&#xA;+ &quot;        'SEMIN_SAS' AS DATABASE_ORIGIN, &quot;&#xD;&#xA;+ &quot;        '' AS ARTICLE_KEY, &quot;&#xD;&#xA;+ &quot;        '' AS CR_MEMO_KEY, &quot;&#xD;&#xA;+ &quot;        '' AS INVOICE_KEY, &quot;&#xD;&#xA;+ &quot;        '' AS MAGASIN_KEY, &quot;&#xD;&#xA;+ &quot;        '' AS VENDEUR_KEY, &quot;&#xD;&#xA;+ &quot;        VE.TYPE AS TYPE, &quot;&#xD;&#xA;+ &quot;        VE.QUANTITY_BASE AS QUANTITY_BASE &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;    FROM VE_AGG VE &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;    LEFT JOIN &quot;&#xD;&#xA;+ context.Snowflake_BDD + &quot;.&quot;&#xD;&#xA;+ context.Snowflake_Schema_SEMIN_SAS&#xD;&#xA;+ &quot;.\&quot;Item\&quot; I &quot;&#xD;&#xA;+ &quot;        ON I.\&quot;No_\&quot; = VE.NO_ &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;    LEFT JOIN &quot;&#xD;&#xA;+ context.Snowflake_BDD + &quot;.&quot;&#xD;&#xA;+ context.Snowflake_Schema_SEMIN_SAS&#xD;&#xA;+ &quot;.FACTURE_LIGNE_SEMIN_S_A_ FL &quot;&#xD;&#xA;+ &quot;        ON FL.DOCUMENT_NO_ = VE.DOCUMENT_NO_ &quot;&#xD;&#xA;+ &quot;       AND FL.LINE_NO_ = VE.LINE_NO_ &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;) AS SRC &quot;&#xD;&#xA;&#xD;&#xA;/*&#xD;&#xA; * Clé fonctionnelle du MERGE :&#xD;&#xA; * une ligne par document, numéro de ligne, type et entité.&#xD;&#xA; */&#xD;&#xA;+ &quot;ON  TGT.DOCUMENT_NO_ = SRC.DOCUMENT_NO_ &quot;&#xD;&#xA;+ &quot;AND TGT.LINE_NO_ = SRC.LINE_NO_ &quot;&#xD;&#xA;+ &quot;AND TGT.TYPE = SRC.TYPE &quot;&#xD;&#xA;+ &quot;AND TGT.DATABASE_ORIGIN = SRC.DATABASE_ORIGIN &quot;&#xD;&#xA;&#xD;&#xA;/*&#xD;&#xA; * Comparaison native et compatible avec les NULL.&#xD;&#xA; * Les colonnes de clé sont volontairement exclues.&#xD;&#xA; */&#xD;&#xA;+ &quot;WHEN MATCHED &quot;&#xD;&#xA;+ &quot;AND ( &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;       TGT.NO_ &quot;&#xD;&#xA;+ &quot;           IS DISTINCT FROM SRC.NO_ &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;    OR TGT.LOCATION_CODE &quot;&#xD;&#xA;+ &quot;           IS DISTINCT FROM SRC.LOCATION_CODE &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;    OR TGT.DESCRIPTION &quot;&#xD;&#xA;+ &quot;           IS DISTINCT FROM SRC.DESCRIPTION &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;    OR TGT.UNIT_OF_MEASURE &quot;&#xD;&#xA;+ &quot;           IS DISTINCT FROM SRC.UNIT_OF_MEASURE &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;    OR TGT.QUANTITY &quot;&#xD;&#xA;+ &quot;           IS DISTINCT FROM SRC.QUANTITY &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;    OR TGT.UNIT_COST__LCY &quot;&#xD;&#xA;+ &quot;           IS DISTINCT FROM SRC.UNIT_COST__LCY &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;    OR TGT.AMOUNT &quot;&#xD;&#xA;+ &quot;           IS DISTINCT FROM SRC.AMOUNT &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;    OR TGT.VAT_BASE_AMOUNT &quot;&#xD;&#xA;+ &quot;           IS DISTINCT FROM SRC.VAT_BASE_AMOUNT &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;    OR TGT.LINE_AMOUNT &quot;&#xD;&#xA;+ &quot;           IS DISTINCT FROM SRC.LINE_AMOUNT &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;    OR TGT.POIDS_NET_ART__ACHETE &quot;&#xD;&#xA;+ &quot;           IS DISTINCT FROM SRC.POIDS_NET_ART__ACHETE &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;    OR TGT.POIDS_NET_ART__FABRIQUE &quot;&#xD;&#xA;+ &quot;           IS DISTINCT FROM SRC.POIDS_NET_ART__FABRIQUE &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;    OR TGT.CODE_VENDEUR &quot;&#xD;&#xA;+ &quot;           IS DISTINCT FROM SRC.CODE_VENDEUR &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;    OR TGT.COUT_SEMIN__DEV_SOC &quot;&#xD;&#xA;+ &quot;           IS DISTINCT FROM SRC.COUT_SEMIN__DEV_SOC &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;    OR TGT.COUT_TRANSPORT__DEV_SOC &quot;&#xD;&#xA;+ &quot;           IS DISTINCT FROM SRC.COUT_TRANSPORT__DEV_SOC &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;    OR TGT.POIDS_NET_ART__PROFILES &quot;&#xD;&#xA;+ &quot;           IS DISTINCT FROM SRC.POIDS_NET_ART__PROFILES &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;    OR TGT.UNIT_OF_MEASURE_CODE &quot;&#xD;&#xA;+ &quot;           IS DISTINCT FROM SRC.UNIT_OF_MEASURE_CODE &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;    OR TGT.ARTICLE_KEY &quot;&#xD;&#xA;+ &quot;           IS DISTINCT FROM SRC.ARTICLE_KEY &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;    OR TGT.CR_MEMO_KEY &quot;&#xD;&#xA;+ &quot;           IS DISTINCT FROM SRC.CR_MEMO_KEY &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;    OR TGT.INVOICE_KEY &quot;&#xD;&#xA;+ &quot;           IS DISTINCT FROM SRC.INVOICE_KEY &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;    OR TGT.MAGASIN_KEY &quot;&#xD;&#xA;+ &quot;           IS DISTINCT FROM SRC.MAGASIN_KEY &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;    OR TGT.VENDEUR_KEY &quot;&#xD;&#xA;+ &quot;           IS DISTINCT FROM SRC.VENDEUR_KEY &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;    OR TGT.QUANTITY_BASE &quot;&#xD;&#xA;+ &quot;           IS DISTINCT FROM SRC.QUANTITY_BASE &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;) &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;THEN UPDATE SET &quot;&#xD;&#xA;&#xD;&#xA;/*&#xD;&#xA; * Les colonnes clés DOCUMENT_NO_, LINE_NO_, TYPE&#xD;&#xA; * et DATABASE_ORIGIN ne sont pas modifiées.&#xD;&#xA; */&#xD;&#xA;+ &quot;    TGT.NO_ = SRC.NO_, &quot;&#xD;&#xA;+ &quot;    TGT.LOCATION_CODE = SRC.LOCATION_CODE, &quot;&#xD;&#xA;+ &quot;    TGT.DESCRIPTION = SRC.DESCRIPTION, &quot;&#xD;&#xA;+ &quot;    TGT.UNIT_OF_MEASURE = SRC.UNIT_OF_MEASURE, &quot;&#xD;&#xA;+ &quot;    TGT.QUANTITY = SRC.QUANTITY, &quot;&#xD;&#xA;+ &quot;    TGT.UNIT_COST__LCY = SRC.UNIT_COST__LCY, &quot;&#xD;&#xA;+ &quot;    TGT.AMOUNT = SRC.AMOUNT, &quot;&#xD;&#xA;+ &quot;    TGT.VAT_BASE_AMOUNT = SRC.VAT_BASE_AMOUNT, &quot;&#xD;&#xA;+ &quot;    TGT.LINE_AMOUNT = SRC.LINE_AMOUNT, &quot;&#xD;&#xA;+ &quot;    TGT.POIDS_NET_ART__ACHETE = SRC.POIDS_NET_ART__ACHETE, &quot;&#xD;&#xA;+ &quot;    TGT.POIDS_NET_ART__FABRIQUE = SRC.POIDS_NET_ART__FABRIQUE, &quot;&#xD;&#xA;+ &quot;    TGT.CODE_VENDEUR = SRC.CODE_VENDEUR, &quot;&#xD;&#xA;+ &quot;    TGT.COUT_SEMIN__DEV_SOC = SRC.COUT_SEMIN__DEV_SOC, &quot;&#xD;&#xA;+ &quot;    TGT.COUT_TRANSPORT__DEV_SOC = SRC.COUT_TRANSPORT__DEV_SOC, &quot;&#xD;&#xA;+ &quot;    TGT.POIDS_NET_ART__PROFILES = SRC.POIDS_NET_ART__PROFILES, &quot;&#xD;&#xA;+ &quot;    TGT.UNIT_OF_MEASURE_CODE = SRC.UNIT_OF_MEASURE_CODE, &quot;&#xD;&#xA;+ &quot;    TGT.ARTICLE_KEY = SRC.ARTICLE_KEY, &quot;&#xD;&#xA;+ &quot;    TGT.CR_MEMO_KEY = SRC.CR_MEMO_KEY, &quot;&#xD;&#xA;+ &quot;    TGT.INVOICE_KEY = SRC.INVOICE_KEY, &quot;&#xD;&#xA;+ &quot;    TGT.MAGASIN_KEY = SRC.MAGASIN_KEY, &quot;&#xD;&#xA;+ &quot;    TGT.VENDEUR_KEY = SRC.VENDEUR_KEY, &quot;&#xD;&#xA;+ &quot;    TGT.QUANTITY_BASE = SRC.QUANTITY_BASE, &quot;&#xD;&#xA;+ &quot;    TGT.DTS_UPDATED_AT = &quot;&#xD;&#xA;+ &quot;        $ETL_BATCH_TIMESTAMP::TIMESTAMP_NTZ &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;WHEN NOT MATCHED THEN &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;INSERT ( &quot;&#xD;&#xA;+ &quot;    DOCUMENT_NO_, &quot;&#xD;&#xA;+ &quot;    LINE_NO_, &quot;&#xD;&#xA;+ &quot;    NO_, &quot;&#xD;&#xA;+ &quot;    LOCATION_CODE, &quot;&#xD;&#xA;+ &quot;    DESCRIPTION, &quot;&#xD;&#xA;+ &quot;    UNIT_OF_MEASURE, &quot;&#xD;&#xA;+ &quot;    QUANTITY, &quot;&#xD;&#xA;+ &quot;    UNIT_COST__LCY, &quot;&#xD;&#xA;+ &quot;    AMOUNT, &quot;&#xD;&#xA;+ &quot;    VAT_BASE_AMOUNT, &quot;&#xD;&#xA;+ &quot;    LINE_AMOUNT, &quot;&#xD;&#xA;+ &quot;    POIDS_NET_ART__ACHETE, &quot;&#xD;&#xA;+ &quot;    POIDS_NET_ART__FABRIQUE, &quot;&#xD;&#xA;+ &quot;    CODE_VENDEUR, &quot;&#xD;&#xA;+ &quot;    COUT_SEMIN__DEV_SOC, &quot;&#xD;&#xA;+ &quot;    COUT_TRANSPORT__DEV_SOC, &quot;&#xD;&#xA;+ &quot;    POIDS_NET_ART__PROFILES, &quot;&#xD;&#xA;+ &quot;    UNIT_OF_MEASURE_CODE, &quot;&#xD;&#xA;+ &quot;    DATABASE_ORIGIN, &quot;&#xD;&#xA;+ &quot;    ARTICLE_KEY, &quot;&#xD;&#xA;+ &quot;    CR_MEMO_KEY, &quot;&#xD;&#xA;+ &quot;    INVOICE_KEY, &quot;&#xD;&#xA;+ &quot;    MAGASIN_KEY, &quot;&#xD;&#xA;+ &quot;    VENDEUR_KEY, &quot;&#xD;&#xA;+ &quot;    TYPE, &quot;&#xD;&#xA;+ &quot;    QUANTITY_BASE, &quot;&#xD;&#xA;+ &quot;    DTS_CREATED_AT, &quot;&#xD;&#xA;+ &quot;    DTS_UPDATED_AT &quot;&#xD;&#xA;+ &quot;) &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;VALUES ( &quot;&#xD;&#xA;+ &quot;    SRC.DOCUMENT_NO_, &quot;&#xD;&#xA;+ &quot;    SRC.LINE_NO_, &quot;&#xD;&#xA;+ &quot;    SRC.NO_, &quot;&#xD;&#xA;+ &quot;    SRC.LOCATION_CODE, &quot;&#xD;&#xA;+ &quot;    SRC.DESCRIPTION, &quot;&#xD;&#xA;+ &quot;    SRC.UNIT_OF_MEASURE, &quot;&#xD;&#xA;+ &quot;    SRC.QUANTITY, &quot;&#xD;&#xA;+ &quot;    SRC.UNIT_COST__LCY, &quot;&#xD;&#xA;+ &quot;    SRC.AMOUNT, &quot;&#xD;&#xA;+ &quot;    SRC.VAT_BASE_AMOUNT, &quot;&#xD;&#xA;+ &quot;    SRC.LINE_AMOUNT, &quot;&#xD;&#xA;+ &quot;    SRC.POIDS_NET_ART__ACHETE, &quot;&#xD;&#xA;+ &quot;    SRC.POIDS_NET_ART__FABRIQUE, &quot;&#xD;&#xA;+ &quot;    SRC.CODE_VENDEUR, &quot;&#xD;&#xA;+ &quot;    SRC.COUT_SEMIN__DEV_SOC, &quot;&#xD;&#xA;+ &quot;    SRC.COUT_TRANSPORT__DEV_SOC, &quot;&#xD;&#xA;+ &quot;    SRC.POIDS_NET_ART__PROFILES, &quot;&#xD;&#xA;+ &quot;    SRC.UNIT_OF_MEASURE_CODE, &quot;&#xD;&#xA;+ &quot;    SRC.DATABASE_ORIGIN, &quot;&#xD;&#xA;+ &quot;    SRC.ARTICLE_KEY, &quot;&#xD;&#xA;+ &quot;    SRC.CR_MEMO_KEY, &quot;&#xD;&#xA;+ &quot;    SRC.INVOICE_KEY, &quot;&#xD;&#xA;+ &quot;    SRC.MAGASIN_KEY, &quot;&#xD;&#xA;+ &quot;    SRC.VENDEUR_KEY, &quot;&#xD;&#xA;+ &quot;    SRC.TYPE, &quot;&#xD;&#xA;+ &quot;    SRC.QUANTITY_BASE, &quot;&#xD;&#xA;+ &quot;    $ETL_BATCH_TIMESTAMP::TIMESTAMP_NTZ, &quot;&#xD;&#xA;+ &quot;    $ETL_BATCH_TIMESTAMP::TIMESTAMP_NTZ &quot;&#xD;&#xA;+ &quot;);&quot;"/>
