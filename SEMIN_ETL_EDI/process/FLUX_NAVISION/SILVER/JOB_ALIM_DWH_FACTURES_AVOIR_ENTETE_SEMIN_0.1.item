;&#xD;&#xA;+ &quot;    SRC.NO_, &quot;&#xD;&#xA;+ &quot;    SRC.SELL_TO_CUSTOMER_NO_, &quot;&#xD;&#xA;+ &quot;    SRC.BILL_TO_CUSTOMER_NO_, &quot;&#xD;&#xA;+ &quot;    SRC.POSTING_DATE, &quot;&#xD;&#xA;+ &quot;    SRC.LOCATION_CODE, &quot;&#xD;&#xA;+ &quot;    SRC.STAND, &quot;&#xD;&#xA;+ &quot;    SRC.CURRENCY_FACTOR, &quot;&#xD;&#xA;+ &quot;    SRC.DATABASE_ORIGIN, &quot;&#xD;&#xA;+ &quot;    SRC.CLIENTSELL_KEY, &quot;&#xD;&#xA;+ &quot;    SRC.CLIENTBILL_KEY, &quot;&#xD;&#xA;+ &quot;    SRC.INVOICE_KEY, &quot;&#xD;&#xA;+ &quot;    SRC.CR_MEMO_KEY, &quot;&#xD;&#xA;+ &quot;    SRC.POSTING_DESCRIPTION, &quot;&#xD;&#xA;+ &quot;    SRC.ORDER_DATE, &quot;&#xD;&#xA;+ &quot;    SRC.ORDER_NO_, &quot;&#xD;&#xA;+ &quot;    $ETL_BATCH_TIMESTAMP::TIMESTAMP_NTZ, &quot;&#xD;&#xA;+ &quot;    $ETL_BATCH_TIMESTAMP::TIMESTAMP_NTZ &quot;&#xD;&#xA;+ &quot;);&quot;"/>
