    <elementParameter field="MEMO_SQL" name="configuration.sqlQuery" value="&quot;MERGE INTO &quot;&#xD;&#xA;+ context.Snowflake_BDD_Silver + &quot;.&quot;&#xD;&#xA;+ context.Snowflake_Schema_Silver&#xD;&#xA;+ &quot;.FACTURES_AVOIR_ENTETE_SEMIN AS TGT &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;USING ( &quot;&#xD;&#xA;+ &quot;    SELECT &quot;&#xD;&#xA;+ &quot;        NO_, &quot;&#xD;&#xA;+ &quot;        SELL_TO_CUSTOMER_NO_, &quot;&#xD;&#xA;+ &quot;        BILL_TO_CUSTOMER_NO_, &quot;&#xD;&#xA;+ &quot;        POSTING_DATE, &quot;&#xD;&#xA;+ &quot;        LOCATION_CODE, &quot;&#xD;&#xA;+ &quot;        STAND, &quot;&#xD;&#xA;+ &quot;        CURRENCY_FACTOR, &quot;&#xD;&#xA;+ &quot;        DATABASE_ORIGIN, &quot;&#xD;&#xA;+ &quot;        CLIENTSELL_KEY, &quot;&#xD;&#xA;+ &quot;        CLIENTBILL_KEY, &quot;&#xD;&#xA;+ &quot;        INVOICE_KEY, &quot;&#xD;&#xA;+ &quot;        CR_MEMO_KEY, &quot;&#xD;&#xA;+ &quot;        POSTING_DESCRIPTION, &quot;&#xD;&#xA;+ &quot;        ORDER_DATE, &quot;&#xD;&#xA;+ &quot;        ORDER_NO_ &quot;&#xD;&#xA;+ &quot;    FROM ( &quot;&#xD;&#xA;+ &quot;        SELECT &quot;&#xD;&#xA;+ &quot;            VE.\&quot;Document No_\&quot; AS NO_, &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;            CASE &quot;&#xD;&#xA;+ &quot;                WHEN FE.SALESPERSON_CODE = '' THEN &quot;&#xD;&#xA;+ &quot;                    CASE &quot;&#xD;&#xA;+ &quot;                        WHEN FE.SHIP_TO_CODE = '' &quot;&#xD;&#xA;+ &quot;                            THEN FE.SELL_TO_CUSTOMER_NO_ &quot;&#xD;&#xA;+ &quot;                        ELSE FE.SHIP_TO_CODE &quot;&#xD;&#xA;+ &quot;                    END &quot;&#xD;&#xA;+ &quot;                ELSE FE.SELL_TO_CUSTOMER_NO_ &quot;&#xD;&#xA;+ &quot;            END AS SELL_TO_CUSTOMER_NO_, &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;            VE.\&quot;Bill-to Customer No_\&quot; AS BILL_TO_CUSTOMER_NO_, &quot;&#xD;&#xA;+ &quot;            VE.\&quot;Posting Date\&quot; AS POSTING_DATE, &quot;&#xD;&#xA;+ &quot;            '' AS LOCATION_CODE, &quot;&#xD;&#xA;+ &quot;            FE.STAND AS STAND, &quot;&#xD;&#xA;+ &quot;            0 AS CURRENCY_FACTOR, &quot;&#xD;&#xA;+ &quot;            'SEMIN_PROFILS' AS DATABASE_ORIGIN, &quot;&#xD;&#xA;+ &quot;            '' AS CLIENTSELL_KEY, &quot;&#xD;&#xA;+ &quot;            '' AS CLIENTBILL_KEY, &quot;&#xD;&#xA;+ &quot;            '' AS INVOICE_KEY, &quot;&#xD;&#xA;+ &quot;            '' AS CR_MEMO_KEY, &quot;&#xD;&#xA;+ &quot;            '' AS POSTING_DESCRIPTION, &quot;&#xD;&#xA;+ &quot;            '' AS ORDER_DATE, &quot;&#xD;&#xA;+ &quot;            '' AS ORDER_NO_, &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;            ROW_NUMBER() OVER ( &quot;&#xD;&#xA;+ &quot;                PARTITION BY &quot;&#xD;&#xA;+ &quot;                    VE.\&quot;Document No_\&quot;, &quot;&#xD;&#xA;+ &quot;                    'SEMIN_PROFILS' &quot;&#xD;&#xA;+ &quot;                ORDER BY &quot;&#xD;&#xA;+ &quot;                    VE.\&quot;Posting Date\&quot; DESC, &quot;&#xD;&#xA;+ &quot;                    VE.\&quot;Bill-to Customer No_\&quot; DESC &quot;&#xD;&#xA;+ &quot;            ) AS RN &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;        FROM &quot;&#xD;&#xA;+ context.Snowflake_BDD + &quot;.&quot;&#xD;&#xA;+ context.Snowflake_Schema_SEMIN_PROFILS&#xD;&#xA;+ &quot;.\&quot;Value_Entry\&quot; VE &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;        LEFT JOIN &quot;&#xD;&#xA;+ context.Snowflake_BDD + &quot;.&quot;&#xD;&#xA;+ context.Snowflake_Schema_SEMIN_PROFILS&#xD;&#xA;+ &quot;.FACTURE_ENTETE_SEMIN_PROFIL FE &quot;&#xD;&#xA;+ &quot;            ON FE.NO_ = VE.\&quot;Document No_\&quot; &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;        WHERE VE.\&quot;Item Charge No_\&quot; = '' &quot;&#xD;&#xA;+ &quot;          AND VE.\&quot;Item No_\&quot; NOT IN ( &quot;&#xD;&#xA;+ &quot;              'A01400', &quot;&#xD;&#xA;+ &quot;              'A11067', &quot;&#xD;&#xA;+ &quot;              'A11068', &quot;&#xD;&#xA;+ &quot;              'A11069', &quot;&#xD;&#xA;+ &quot;              'A11070', &quot;&#xD;&#xA;+ &quot;              'A11599', &quot;&#xD;&#xA;+ &quot;              'A12254' &quot;&#xD;&#xA;+ &quot;          ) &quot;&#xD;&#xA;+ &quot;          AND VE.\&quot;Document Type\&quot; = '2' &quot;&#xD;&#xA;+ &quot;    ) SRC_DEDUP &quot;&#xD;&#xA;+ &quot;    WHERE RN = 1 &quot;&#xD;&#xA;+ &quot;) AS SRC &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;ON  TGT.NO_ = SRC.NO_ &quot;&#xD;&#xA;+ &quot;AND TGT.DATABASE_ORIGIN = SRC.DATABASE_ORIGIN &quot;&#xD;&#xA;&#xD;&#xA;+ &quot;WHEN MATCHED &quot;&#xD;&#xA;+ &quot;AND HASH( &quot;&#xD;&#xA;+ &quot;    TGT.NO_, &quot;&#xD;&#xA;+ &quot;    TGT.SELL_TO_CUSTOMER_NO_, &quot;&#xD;&#xA;+ &quot;    TGT.BILL_TO_CUSTOMER_NO_, &quot;&#xD;&#xA;+ &quot;    TGT.POSTING_DATE, &quot;&#xD;&#xA;+ &quot;    TGT.LOCATION_CODE, &quot;&#xD;&#xA;+ &quot;    TGT.STAND, &quot;&#xD;&#xA;+ &quot;    TGT.CURRENCY_FACTOR, &quot;&#xD;&#xA;+ &quot;    TGT.DATABASE_ORIGIN, &quot;&#xD;&#xA;+ &quot;    TGT.CLIENTSELL_KEY, &quot;&#xD;&#xA;+ &quot;    TGT.CLIENTBILL_KEY, &quot;&#xD;&#xA;+ &quot;    TGT.INVOICE_KEY, &quot;&#xD;&#xA;+ &quot;    TGT.CR_MEMO_KEY, &quot;&#xD;&#xA;+ &quot;    TGT.POSTING_DESCRIPTION, &quot;&#xD;&#xA;+ &quot;    TGT.ORDER_DATE, &quot;&#xD;&#xA;+ &quot;    TGT.ORDER_NO_ &quot;&#xD;&#xA;+ &quot;) &lt;> HASH( &quot;&#xD;&#xA;+ &quot;    SRC.NO_, &quot;&#xD;&#xA;+ &quot;    SRC.SELL_TO_CUSTOMER_NO_, &quot;&#xD;&#xA;+ &quot;    SRC.BILL_TO_CUSTOMER_NO_, &quot;&#xD;&#xA;+ &quot;    SRC.POSTING_DATE, &quot;&#xD;&#xA;+ &quot;    SRC.LOCATION_CODE, &quot;&#xD;&#xA;+ &quot;    SRC.STAND, &quot;&#xD;&#xA;+ &quot;    SRC.CURRENCY_FACTOR, &quot;&#xD;&#xA;+ &quot;    SRC.DATABASE_ORIGIN, &quot;&#xD;&#xA;+ &quot;    SRC.CLIENTSELL_KEY, &quot;&#xD;&#xA;+ &quot;    SRC.CLIENTBILL_KEY, &quot;&#xD;&#xA;+ &quot;    SRC.INVOICE_KEY, &quot;&#xD;&#xA;+ &quot;    SRC.CR_MEMO_KEY, &quot;&#xD;&#xA;+ &quot;    SRC.POSTING_DESCRIPTION, &quot;&#xD;&#xA;+ &quot;    SRC.ORDER_DATE, &quot;&#xD;&#xA;+ &quot;    SRC.ORDER_NO_ &quot;&#xD;&#xA;+ &quot;) &quot;&#xD;&#xA;&#xD;&#