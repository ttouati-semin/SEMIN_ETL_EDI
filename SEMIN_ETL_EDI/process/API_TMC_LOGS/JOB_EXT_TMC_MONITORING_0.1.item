  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="360" posY="120">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_1" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="//Code complet a coller dans les parametres simples du composant tJava.&#xD;&#xA;//Contexte Studio requis : Context_Properties_File (String).&#xD;&#xA;//Le fichier properties est prioritaire sur les valeurs ci-dessous.&#xD;&#xA;java.util.Properties tmcDefaults = new java.util.Properties();&#xD;&#xA;tmcDefaults.setProperty(&quot;TMC_Source&quot;, &quot;SEMIN&quot;);&#xD;&#xA;tmcDefaults.setProperty(&quot;TMC_Api_Base_Url&quot;, &quot;https://api.eu.cloud.talend.com&quot;);&#xD;&#xA;tmcDefaults.setProperty(&quot;TMC_Access_Token&quot;, &quot;&quot;);&#xD;&#xA;tmcDefaults.setProperty(&quot;TMC_Environment_Names&quot;, &quot;DEVELOPPEMENT&quot;);&#xD;&#xA;tmcDefaults.setProperty(&quot;TMC_Tasks_Path&quot;, &quot;/orchestration/executables/tasks&quot;);&#xD;&#xA;tmcDefaults.setProperty(&quot;TMC_Lookback_Hours&quot;, &quot;48&quot;);&#xD;&#xA;tmcDefaults.setProperty(&quot;TMC_Page_Size&quot;, &quot;100&quot;);&#xD;&#xA;tmcDefaults.setProperty(&quot;TMC_Request_Timeout_Seconds&quot;, &quot;60&quot;);&#xD;&#xA;tmcDefaults.setProperty(&quot;TMC_Max_Retries&quot;, &quot;3&quot;);&#xD;&#xA;tmcDefaults.setProperty(&quot;TMC_Window_Hours&quot;, &quot;6&quot;);&#xD;&#xA;tmcDefaults.setProperty(&quot;TMC_End_Lag_Seconds&quot;, &quot;60&quot;);&#xD;&#xA;tmcDefaults.setProperty(&quot;TMC_Max_Recovery_Days&quot;, &quot;30&quot;);&#xD;&#xA;tmcDefaults.setProperty(&quot;TMC_From_UTC&quot;, &quot;&quot;);&#xD;&#xA;tmcDefaults.setProperty(&quot;TMC_To_UTC&quot;, &quot;&quot;);&#xD;&#xA;tmcDefaults.setProperty(&quot;Snowflake_Account&quot;, &quot;QMKZKFX-HG22197&quot;);&#xD;&#xA;tmcDefaults.setProperty(&quot;Snowflake_User&quot;, &quot;S_TALEND_DEV&quot;);&#xD;&#xA;tmcDefaults.setProperty(&quot;Snowflake_Warehouse_Bronze&quot;, &quot;COMPUTE_ETL_DEV&quot;);&#xD;&#xA;tmcDefaults.setProperty(&quot;Snowflake_BDD&quot;, &quot;DB_RAW_DATA_DEV&quot;);&#xD;&#xA;tmcDefaults.setProperty(&quot;Snowflake_Schema_TMC&quot;, &quot;TMC_MONITORING&quot;);&#xD;&#xA;tmcDefaults.setProperty(&quot;Snowflake_Role&quot;, &quot;R_DB_RAW_DATA_DEV_OW&quot;);&#xD;&#xA;tmcDefaults.setProperty(&quot;Snowflake_Driver&quot;, &quot;net.snowflake.client.jdbc.SnowflakeDriver&quot;);&#xD;&#xA;tmcDefaults.setProperty(&quot;Snowflake_JDBC_Jar&quot;, &quot;C:/Talend/lib/snowflake-jdbc.jar&quot;);&#xD;&#xA;tmcDefaults.setProperty(&quot;Keystore_path&quot;, &quot;C:/Talend/snowflake_keystore.p12&quot;);&#xD;&#xA;tmcDefaults.setProperty(&quot;Keystore_password&quot;, &quot;&quot;);&#xD;&#xA;tmcDefaults.setProperty(&quot;Keystore_Alias&quot;, &quot;&quot;);&#xD;&#xA;tmcDefaults.setProperty(&quot;Keystore_Key_Password&quot;, &quot;&quot;);&#xD;&#xA;tmcDefaults.setProperty(&quot;Folder_Root_PRJ&quot;, &quot;D:/Talend_Bulk_Exchange_Folder/WORK&quot;);&#xD;&#xA;tmcDefaults.setProperty(&quot;TMC_SMTP_Host&quot;, &quot;smtp.semin.fr&quot;);&#xD;&#xA;tmcDefaults.setProperty(&quot;TMC_SMTP_Port&quot;, &quot;25&quot;);&#xD;&#xA;tmcDefaults.setProperty(&quot;TMC_Email_From&quot;, &quot;&quot;);&#xD;&#xA;tmcDefaults.setProperty(&quot;TMC_Email_To&quot;, &quot;&quot;);&#xD;&#xA;&#xD;&#xA;java.util.Properties tmcConfig = routines.TmcConfig.load(&#xD;&#xA; context.Context_Properties_File,&#xD;&#xA; tmcDefaults&#xD;&#xA;);&#xD;&#xA;&#xD;&#xA;//Ce premier montage est destine aux tables deja creees en DEV.&#xD;&#xA;if (!&quot;DB_RAW_DATA_DEV&quot;.equalsIgnoreCase(&#xD;&#xA;     tmcConfig.getProperty(&quot;Snowflake_BDD&quot;, &quot;&quot;).trim())) {&#xD;&#xA; throw new IllegalArgumentException(&#xD;&#xA;     &quot;Ce lancement doit cibler DB_RAW_DATA_DEV. Corriger Snowflake_BDD dans le fichier properties.&quot;&#xD;&#xA; );&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;//Verifications avant tout appel HTTP ou JDBC. Aucun secret n'est affiche.&#xD;&#xA;String[] tmcRequiredKeys = {&#xD;&#xA; &quot;TMC_Source&quot;, &quot;TMC_Api_Base_Url&quot;, &quot;TMC_Access_Token&quot;, &quot;TMC_Environment_Names&quot;,&#xD;&#xA; &quot;Snowflake_Account&quot;, &quot;Snowflake_User&quot;, &quot;Snowflake_Warehouse_Bronze&quot;,&#xD;&#xA; &quot;Snowflake_BDD&quot;, &quot;Snowflake_Schema_TMC&quot;, &quot;Snowflake_Role&quot;,&#xD;&#xA; &quot;Snowflake_Driver&quot;, &quot;Keystore_path&quot;, &quot;Keystore_password&quot;, &quot;Folder_Root_PRJ&quot;,&#xD;&#xA; &quot;TMC_SMTP_Host&quot;, &quot;TMC_SMTP_Port&quot;, &quot;TMC_Email_From&quot;, &quot;TMC_Email_To&quot;&#xD;&#xA;};&#xD;&#xA;for (String tmcKey : tmcRequiredKeys) {&#xD;&#xA; routines.TmcConfig.req(tmcConfig, tmcKey);&#xD;&#xA;}&#xD;&#xA;routines.TmcMail.validateConfig(&#xD;&#xA; tmcConfig.getProperty(&quot;TMC_SMTP_Host&quot;),&#xD;&#xA; routines.TmcConfig.integer(tmcConfig, &quot;TMC_SMTP_Port&quot;, 1, 65535),&#xD;&#xA; tmcConfig.getProperty(&quot;TMC_Email_From&quot;),&#xD;&#xA; tmcConfig.getProperty(&quot;TMC_Email_To&quot;)&#xD;&#xA;);&#xD;&#xA;&#xD;&#xA;routines.TmcMonitoring.Session tmcSession = new routines.TmcMonitoring.Session(tmcConfig);&#xD;&#xA;try {&#xD;&#xA; String[] tmcPhases = { &quot;connect&quot;, &quot;inventory&quot;, &quot;tasks&quot;, &quot;executions&quot;, &quot;publish&quot; };&#xD;&#xA; for (String tmcPhase : tmcPhases) {&#xD;&#xA;     System.out.println(&quot;[TMC] Phase : &quot; + tmcPhase);&#xD;&#xA;     tmcSession.phase(tmcPhase);&#xD;&#xA; }&#xD;&#xA; System.out.println(&quot;[TMC] Collecte terminee et publication validee dans DB_RAW_DATA_DEV.&quot;);&#xD;&#xA; System.out.println(&quot;[TMC] Envoi du rapport HTML J-1 par SMTP...&quot;);&#xD;&#xA; tmcSession.sendDailyEmail();&#xD;&#xA;} finally {&#xD;&#xA; tmcSession.close();&#xD;&#xA;}&#xD;&#xA;"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;&#xA;import routines.TmcConfig;"/>
